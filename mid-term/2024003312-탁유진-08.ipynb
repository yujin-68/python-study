   "source": [
    "a, b = 0, 1\n",
    "fib_even = []\n",
    "while a <= 1000000:\n",
    "    if a % 2 == 0:\n",
    "        fib_even.append(a)\n",
    "    a, b = b, a + b\n",
    "\n",
    "print(sum(fib_even))"
   ]
