   ],
   "source": [
    "result = []\n",
    "\n",
    "for i in range(100,1000):\n",
    "    for j in range(100,1000):\n",
    "        num = i * j\n",
    "        str_num = str(num)\n",
    "        if str_num[:3] == str_num[-1:-4:-1]: \n",
    "            result.append(num)\n",
    "\n",
    "print(max(result))"
   ]
  }
