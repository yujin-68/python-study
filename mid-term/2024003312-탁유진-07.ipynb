   "source": [
    "암스트롱수 구하기"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "1b5cc247-ca40-4812-b8d5-61c46aeeae64",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1634는 암스트롱 수 입니다.\n",
      "8208는 암스트롱 수 입니다.\n",
      "9474는 암스트롱 수 입니다.\n"
     ]
    }
   ],
   "source": [
    "range_list = list(range(1000,10000))\n",
    "\n",
    "for num in range_list:\n",
    "    total = 0\n",
    "    str_list = list(str(num))\n",
    "    for i in range(4):    #4자리 각각의 수를 4제곱하여 total에 더하기\n",
    "        total += int(str_list[i]) ** 4\n",
    "    if total == num: print(f\"{num}는 암스트롱 수 입니다.\")"
   ]
  }
 ],
