     "text": [
      "양의 정수를 입력해주세요:  10\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10은 소수가 아닙니다.\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"양의 정수를 입력해주세요: \"))\n",
    "\n",
    "is_prime = True\n",
    "for i in range(2, n):\n",
    "    if n % i == 0: \n",
    "        is_prime = False\n",
    "        break\n",
    "if is_prime:\n",
    "    print(f\"{n}은 소수입니다.\")\n",
    "else:\n",
    "    print(f\"{n}은 소수가 아닙니다.\")"
   ]
  }
 ],
